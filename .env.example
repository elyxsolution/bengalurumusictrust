# Razorpay Standard Checkout (donations on the Get Involved page).
# Copy to .env.local for local runs, and set the same names under Vercel > Project > Settings > Environment Variables.
# These are read only by the serverless functions in /api. Never prefix them with NEXT_PUBLIC_ or expose them to the browser.

# "test" (default) or "live". Live is never used unless this is explicitly set to "live".
RAZORPAY_MODE=test

# Razorpay Dashboard > Test Mode > Account & Settings > API Keys. In test mode the key id starts with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_KEY_SECRET
